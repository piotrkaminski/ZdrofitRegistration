# Zdrofit credentials (optional, interactive login via --login is recommended)
ZDROFIT_EMAIL=your_email@example.com
ZDROFIT_PASSWORD=your_password

# Default club slug from zdrofit.pl URL
# e.g., for https://zdrofit.pl/kluby-fitness/zerniki-wroclawskie-zasluczanska/grafik-zajec
# the slug is: zerniki-wroclawskie-zasluczanska
DEFAULT_CLUB=zerniki-wroclawskie-zasluczanska
